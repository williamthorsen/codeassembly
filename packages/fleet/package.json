{
  "name": "codeassembly-fleet",
  "version": "0.1.0",
  "private": true,
  "description": "Fleet-visibility server: Watches the events root, folds lane state, and streams snapshots over SSE",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts"
    }
  },
  "scripts": {
    "build": ":",
    "dev": "tsx --watch src/main.ts",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@williamthorsen/toolbelt.errors": "catalog:",
    "codeassembly-lifecycle": "workspace:*",
    "hono": "4.12.34"
  },
  "engines": {
    "node": ">=24"
  }
}
