# Generated esbuild bundles of skill helpers, not authored source. Prettier exhibits a
# non-idempotent reformatting bug on long ternary expressions emitted by the bundler (the
# `yaml` package surfaces the pattern).
content/skills/**/*.mjs
content/scripts/**/*.mjs

# Partials must preserve exact whitespace around `<!-- include: ... -->` open/close
# directives and `<!-- children -->` placeholders. Prettier's auto-insertion of blank lines
# around HTML-comment lines breaks slot substitution semantics — see
# content/_partials/README.md.
content/_partials/
