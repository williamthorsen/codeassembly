{
  "name": "codeassembly",
  "version": "0.16.0",
  "description": "CLI that installs reusable AI agent guidance (rulebooks, skills, and subagents) into coding-harness directories",
  "keywords": [
    "agents",
    "ai",
    "claude-code",
    "cli",
    "skills"
  ],
  "homepage": "https://github.com/williamthorsen/codeassembly/tree/main/packages/agents#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/codeassembly/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/williamthorsen/codeassembly.git",
    "directory": "packages/agents"
  },
  "license": "ISC",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./api": {
      "source": "./src/api.ts",
      "types": "./dist/esm/api.d.ts",
      "import": "./dist/esm/api.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "codeassembly": "bin/codeassembly.js"
  },
  "files": [
    ".readyup/kits/*.js",
    ".readyup/manifest.json",
    "bin",
    "dist",
    "!dist/content"
  ],
  "scripts": {
    "build:post": "node bin/codeassembly.js bundle-helpers --content content && node scripts/add-cli-shebang.ts && rdy compile",
    "build:pre": "rdy verify",
    "check-bundles": "node bin/codeassembly.js bundle-helpers --content content --check",
    "prepublishOnly": "nmr build",
    "test:post": "pnpm run test:sh && pnpm run test:smoke",
    "test:sh": "bash scripts/test-sh.sh",
    "test:smoke": "node scripts/__tests__/smoke-test-skill-helpers.ts"
  },
  "dependencies": {
    "@williamthorsen/kb": "workspace:*",
    "@williamthorsen/toolbelt.errors": "catalog:",
    "@williamthorsen/toolbelt.terminal": "catalog:",
    "codeassembly-lifecycle": "workspace:*",
    "ulid": "3.0.2",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hyperjump/json-schema": "1.17.8",
    "@types/node": "catalog:",
    "@williamthorsen/nmr": "catalog:",
    "@williamthorsen/toolbelt.strings": "8.0.1",
    "@williamthorsen/toolbelt.testing": "catalog:",
    "@williamthorsen/toolbelt.vitest": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "readyup": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "esbuild": "^0.28.2"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
