{
  "name": "@codeassembly/agents",
  "version": "0.3.0",
  "private": true,
  "description": "Specialized subagents for orchestrated development workflows",
  "type": "module",
  "bin": {
    "codeassembly-agents": "bin/codeassembly-agents.js"
  },
  "scripts": {
    "build": "nmr compile && tsx scripts/bundle-skill-helpers.ts && tsx scripts/copy-content.ts",
    "test:post": "pnpm run test:sh && pnpm run test:smoke",
    "test:sh": "bash scripts/test-sh.sh",
    "test:smoke": "tsx scripts/__tests__/smoke-test-skill-helpers.ts"
  },
  "dependencies": {
    "@codeassembly/kb": "workspace:*",
    "@codeassembly/lifecycle": "workspace:*",
    "ulid": "3.0.2",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hyperjump/json-schema": "1.17.7",
    "@types/node": "24.13.3",
    "@williamthorsen/toolbelt.strings": "3.1.8",
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": ">=24"
  }
}
