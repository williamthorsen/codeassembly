{
  "name": "codeassembly-agent-logic",
  "version": "0.11.0",
  "description": "Model of an agent prompt's states and transitions, with React and server entries for the apps that present it",
  "keywords": [
    "agents",
    "ai",
    "react",
    "statechart"
  ],
  "homepage": "https://github.com/williamthorsen/codeassembly/tree/main/packages/agent-logic#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/codeassembly/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/williamthorsen/codeassembly.git",
    "directory": "packages/agent-logic"
  },
  "license": "ISC",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./agent": {
      "types": "./dist/esm/agent/index.d.ts",
      "import": "./dist/esm/agent/index.js"
    },
    "./agent-logic.schema.json": "./schema/agent-logic.schema.json",
    "./client": {
      "types": "./dist/esm/client/index.d.ts",
      "import": "./dist/esm/client/index.js"
    },
    "./job": {
      "types": "./dist/esm/job/index.d.ts",
      "import": "./dist/esm/job/index.js"
    },
    "./react": {
      "types": "./dist/esm/react/index.d.ts",
      "import": "./dist/esm/react/index.js"
    },
    "./react/styles.css": "./dist/esm/react/styles.css",
    "./server": {
      "types": "./dist/esm/server/index.d.ts",
      "import": "./dist/esm/server/index.js"
    }
  },
  "main": "./dist/esm/index.js",
  "bin": {
    "agent-logic": "bin/agent-logic.js"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "schema",
    "CHANGELOG.md",
    ".meta/changelog.json"
  ],
  "scripts": {
    "build:post": "cp src/react/styles.css dist/esm/react/styles.css",
    "generate:instructions": "node src/instructions/write-conversion-instructions.ts",
    "generate:schema": "node src/schema/write-json-schema.ts",
    "prepublishOnly": "nmr build",
    "refresh-corpus": "node src/corpus/refresh-corpus.ts",
    "score-corpus": "node src/corpus/score-corpus-command.ts"
  },
  "dependencies": {
    "@williamthorsen/toolbelt.errors": "catalog:",
    "@williamthorsen/toolbelt.text-file-store": "0.2.0",
    "@xyflow/react": "13.0.2",
    "elkjs": "0.12.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@williamthorsen/nmr": "catalog:",
    "@williamthorsen/toolbelt.acp": "0.3.3",
    "@williamthorsen/toolbelt.llm": "0.4.0",
    "eslint": "catalog:",
    "eslint-plugin-jest-dom": "5.11.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "catalog:",
    "vitest": "catalog:",
    "xstate": "5.33.4"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@williamthorsen/toolbelt.acp": "^0.3.0",
    "@williamthorsen/toolbelt.llm": ">=0.1.0 <1.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "@williamthorsen/toolbelt.acp": {
      "optional": true
    },
    "@williamthorsen/toolbelt.llm": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
