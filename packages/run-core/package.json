{
  "name": "@codeassembly/run-core",
  "version": "0.1.0",
  "private": true,
  "description": "Core runtime for orchestrated development runs",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/esm/index.js",
      "types": "./src/index.ts"
    },
    "./config": {
      "source": "./src/config.ts",
      "import": "./dist/esm/config.js",
      "types": "./src/config.ts"
    },
    "./parsers": {
      "source": "./src/parsers/run-data-parser.ts",
      "import": "./dist/esm/parsers/run-data-parser.js",
      "types": "./src/parsers/run-data-parser.ts"
    },
    "./scanners": {
      "source": "./src/scanners/index.ts",
      "import": "./dist/esm/scanners/index.js",
      "types": "./src/scanners/index.ts"
    }
  },
  "main": "./dist/esm/index.js",
  "bin": {
    "codeassembly-runs": "dist/esm/cli.js"
  },
  "scripts": {
    "build": "nmr compile",
    "prepare": "nmr compile"
  },
  "dependencies": {
    "js-yaml": "4.1.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9"
  }
}
