{
  "name": "codeassembly-run-core",
  "version": "0.3.1",
  "private": true,
  "description": "Core runtime for orchestrated development runs",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./config": {
      "source": "./src/config.ts",
      "types": "./dist/esm/config.d.ts",
      "import": "./dist/esm/config.js"
    },
    "./parsers": {
      "source": "./src/parsers/run-data-parser.ts",
      "types": "./dist/esm/parsers/run-data-parser.d.ts",
      "import": "./dist/esm/parsers/run-data-parser.js"
    },
    "./scanners": {
      "source": "./src/scanners/index.ts",
      "types": "./dist/esm/scanners/index.d.ts",
      "import": "./dist/esm/scanners/index.js"
    }
  },
  "main": "./dist/esm/index.js",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@williamthorsen/toolbelt.errors": "catalog:",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=24"
  }
}
