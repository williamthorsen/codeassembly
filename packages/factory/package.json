{
  "name": "@codeassembly/factory",
  "version": "0.2.7",
  "private": true,
  "description": "Visual factory for orchestrated workflow management",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "type": "module",
  "scripts": {
    "build": "pnpm vite build",
    "dev": "tsx src/server/index.ts & pnpm vite --host",
    "dev:client": "pnpm vite --host",
    "dev:server": "tsx --watch src/server/index.ts",
    "generate-sprites": "tsx scripts/generate-placeholder-pngs.ts",
    "validate:run-index": "tsx src/scripts/validate-run-index.ts"
  },
  "dependencies": {
    "@williamthorsen/toolbelt.errors": "catalog:",
    "@xyflow/react": "12.11.3",
    "codeassembly-run-core": "workspace:*",
    "cors": "2.8.6",
    "excalibur": "0.32.0",
    "express": "5.2.1",
    "marked": "18.0.9",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@williamthorsen/nmr": "catalog:",
    "@williamthorsen/toolbelt.vitest": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react": "catalog:",
    "jsdom": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
