{
  "name": "@codeassembly/factory",
  "version": "0.2.5",
  "private": true,
  "description": "Visual factory for orchestrated workflow management",
  "type": "module",
  "scripts": {
    "build": "pnpm vite build",
    "dev": "tsx src/server/index.ts & pnpm vite --host",
    "dev:client": "pnpm vite --host",
    "dev:server": "tsx --watch src/server/index.ts",
    "generate-sprites": "tsx scripts/generate-placeholder-pngs.ts",
    "validate:run-index": "tsx src/scripts/validate-run-index.ts"
  },
  "dependencies": {
    "@williamthorsen/toolbelt.errors": "catalog:",
    "@xyflow/react": "12.11.2",
    "codeassembly-run-core": "workspace:*",
    "cors": "2.8.6",
    "excalibur": "0.32.0",
    "express": "5.2.1",
    "marked": "18.0.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint-plugin-react": "7.37.5",
    "jsdom": "30.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
