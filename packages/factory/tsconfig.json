{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "strict": true,
    "useDefineForClassFields": true,
  },
  // prettier-ignore
  "include": [
    "./.config/**/*.ts",
    "docs/visions/",
    "src/",
    "scripts/",
    "*.ts",
  ],
}
