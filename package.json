{
  "name": "codeassembly-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "CodeAssembly monorepo",
  "keywords": [
    "agents",
    "ai",
    "code-orchestration",
    "monorepo"
  ],
  "homepage": "https://github.com/williamthorsen/codeassembly#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/codeassembly/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamthorsen/codeassembly.git"
  },
  "license": "ISC",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "type": "module",
  "scripts": {
    "agents:install": "tsx packages/agents/src/cli.ts install",
    "agents:install-launchers": "bash packages/agents/scripts/install-launchers.sh",
    "agents:sync": "node packages/agents/bin/codeassembly.js sync",
    "bootstrap": "nmr build && pnpm run agents:sync",
    "check:strict:post": "pnpm --filter codeassembly run check-bundles",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "@williamthorsen/eslint-config-typescript": "13.0.0",
    "@williamthorsen/kb": "workspace:*",
    "@williamthorsen/nmr": "catalog:",
    "@williamthorsen/release-kit": "10.5.0",
    "@williamthorsen/strict-lint": "12.0.0",
    "@williamthorsen/toolbelt.errors": "catalog:",
    "@williamthorsen/toolbelt.testing": "catalog:",
    "@williamthorsen/toolbelt.vitest": "catalog:",
    "codeassembly": "workspace:*",
    "dotenv": "17.4.2",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "glob": "13.0.6",
    "lefthook": "2.1.12",
    "prettier": "3.9.6",
    "readyup": "catalog:",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "v11y-check": "0.15.8",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  }
}
