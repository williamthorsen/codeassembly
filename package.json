{
  "name": "codeassembly-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "CodeAssembly monorepo",
  "keywords": [],
  "homepage": "https://github.com/williamthorsen/codeassembly#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/codeassembly/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamthorsen/codeassembly.git"
  },
  "license": "ISC",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "agents:install": "tsx packages/agents/src/cli.ts install",
    "agents:install-launchers": "bash packages/agents/scripts/install-launchers.sh",
    "agents:sync": "node packages/agents/bin/codeassembly.js sync",
    "bootstrap": "nmr build && pnpm run agents:sync",
    "ci:post": "pnpm --filter codeassembly run test:sh",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@types/node": "24.13.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.24",
    "@williamthorsen/eslint-config-typescript": "8.5.0",
    "@williamthorsen/kb": "workspace:*",
    "@williamthorsen/nmr": "0.27.0",
    "@williamthorsen/release-kit": "10.2.2",
    "@williamthorsen/strict-lint": "9.3.0",
    "codeassembly": "workspace:*",
    "dotenv": "17.4.2",
    "eslint": "10.8.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest-dom": "5.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "glob": "13.0.6",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "readyup": "0.24.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "v11y-check": "0.14.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  }
}
