{
  "name": "codeassembly-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "CodeAssembly monorepo",
  "keywords": [],
  "homepage": "https://github.com/williamthorsen/codeassembly#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/codeassembly/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamthorsen/codeassembly.git"
  },
  "license": "UNLICENSED",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "agents:install": "tsx packages/agents/src/cli.ts install",
    "agents:install-launchers": "bash packages/agents/scripts/install-launchers.sh",
    "agents:sync": "node packages/agents/bin/codeassembly-agents.js sync",
    "bootstrap": "nmr build && pnpm run agents:sync",
    "ci:post": "pnpm --filter agents run test:sh",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@types/node": "24.13.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.23",
    "@williamthorsen/eslint-config-typescript": "8.1.0",
    "@williamthorsen/nmr": "0.20.0",
    "@williamthorsen/release-kit": "9.0.0",
    "@williamthorsen/strict-lint": "9.0.1",
    "dotenv": "17.4.2",
    "eslint": "10.7.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest-dom": "5.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "glob": "13.0.6",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "readyup": "0.22.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "v11y-check": "0.11.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  }
}
