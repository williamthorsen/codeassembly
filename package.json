  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@types/eslint": "9.6.1",
    "@types/node": "24.12.3",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "@vitest/eslint-plugin": "1.6.17",
    "@williamthorsen/audit-deps": "0.6.1",
    "@williamthorsen/eslint-config-typescript": "5.17.4",
    "@williamthorsen/nmr": "0.13.0",
    "@williamthorsen/release-kit": "5.2.1",
    "@williamthorsen/strict-lint": "6.3.0",
    "dotenv": "17.4.2",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest-dom": "5.5.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-testing-library": "7.16.2",
    "glob": "13.0.6",
    "lefthook": "2.1.6",
    "prettier": "3.8.3",
    "readyup": "0.20.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2",
    "vite": "8.0.11",
    "vitest": "4.1.5"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "lefthook",
      "sharp",
      "svelte-preprocess"
    ]
  }
}
