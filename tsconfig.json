// Monorepo root TSConfig: the shared base plus the settings that this repo adds. Packages extend this file.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@williamthorsen/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    // Match the `source` export condition, so workspace dependencies resolve to their TypeScript source rather than
    // their built declarations. This mirrors the `source` condition nmr's Vitest factory resolves, and lets in-repo
    // typechecking run without a prior build. External consumers don't set this condition and fall through to `types`.
    "customConditions": ["source"],
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    // Report an error when importing a file using a casing different from the casing on disk.
    "forceConsistentCasingInFileNames": true,
    "noLib": false,

    // Enable JSON imports.
    "resolveJsonModule": true,
    "sourceMap": true,

    // TypeScript no longer includes ambient `@types` packages automatically, so a package that imports a
    // `node:` builtin sees no declaration for it unless "node" is named here.
    "types": ["node"],
  },
  "exclude": ["node_modules"],
  "include": [
    // This file covers only the monorepo root. Packages have their own tsconfig.json files that extend this one.
    ".config/**/*.ts",
    ".readyup/**/*.ts",
    "__tests__/",
    "config/",
    "scripts/",
    "*.ts",
  ],
}
